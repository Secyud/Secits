@namespace Secyud.Secits.Blazor
@inherits LayoutComponentBase
<SAppContainer Class="demo-layout">
    <div class="demo-menu">
        <div class="demo-menu-item outer">
            @foreach (var (name, url) in DemoMenus.Items)
            {
                <a class="demo-menu-item-link" href="@url">
                    <div class="demo-menu-item-text">@name</div>
                </a>
            }
        </div>
    </div>
    <div class="demo-body">
        @Body
    </div>
</SAppContainer>