@inherits LayoutComponentBase
<SecitsStylesImport/>
<LayoutMenu Class="sc-pin-menu left">
    @GenerateLayoutLftMenu()
</LayoutMenu>

<ErrorBoundary>
    <ChildContent>
        <div class="sc-container">
            @Body
        </div>
    </ChildContent>
    <ErrorContent>
        <div class="sc-error-content">
            <a class="help-link" href="@context.HelpLink"> @context.HelpLink</a>
            <div class="error-message">
                @context.Message
            </div>
            <div class="stack-trace">
                @context.StackTrace
            </div>
        </div>
    </ErrorContent>
</ErrorBoundary>

<SecitsScriptsImport/>

@code
{
    RenderFragment GenerateLayoutLftMenu() =>
        __builder =>
        {
            <MainMenu/>
        };
}