@using Secyud.Secits.Blazor.General
@attribute [Route(DemoMenus.Avatar)]
@{
    const string src = "_content/Secyud.Secits.Blazor/icons/svg/solid/si-pin.svg";
}
<SCard>
    <SCardHeader>
        Avatar
    </SCardHeader>
    <SCardBody>
        <SGridRow>
            <SGridCol>
                <DemoShowcase Text="Circle Default">
                    <SAvatar/>
                </DemoShowcase>
            </SGridCol>
            <SGridCol>
                <DemoShowcase Text="Circle Text">
                    <SAvatar Text="Secits Avatar"/>
                </DemoShowcase>
            </SGridCol>
            <SGridCol>
                <DemoShowcase Text="Circle Image">
                    <SAvatar Src="@src"/>
                </DemoShowcase>
            </SGridCol>
        </SGridRow>
        <SGridRow>
            <SGridCol>
                <DemoShowcase Text="Square Default">
                    <SAvatar Shape="SAvatarShape.Square"/>
                </DemoShowcase>
            </SGridCol>
            <SGridCol>
                <DemoShowcase Text="Square Text">
                    <SAvatar Shape="SAvatarShape.Square" Text="Secits Avatar"/>
                </DemoShowcase>
            </SGridCol>
            <SGridCol>
                <DemoShowcase Text="Square Image">
                    <SAvatar Shape="SAvatarShape.Square" Src="@src"/>
                </DemoShowcase>
            </SGridCol>
        </SGridRow>
    </SCardBody>
</SCard>

