@namespace Secyud.Secits.Blazor
@typeparam TValue
@using Secyud.Secits.Blazor.Plugins
@inherits CComponentBase

<CascadingValue Value="PluginContext" IsFixed>
    @Plugins
    @if (EnableValidation)
    {
        <SpInputValidate TValue="TValue" />
    }
</CascadingValue>

<div @ref="ElementRef" class="@GetClass()" style="@GetStyle()">
    @(BuildInputRenderTree)
    <span class="s-input-elements">
        @GenerateElements()
    </span>
</div>

@code{

    protected virtual RenderFragment GenerateElements() => __builder =>
    {
        @foreach (var value in _inputElements)
        {
            @(value.GenerateInputElement)
        }
    };

}