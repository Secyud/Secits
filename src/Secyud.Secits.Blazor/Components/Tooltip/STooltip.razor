@namespace Secyud.Secits.Blazor
@inherits CComponentBase

<div @ref="ElementRef" class="s-tooltip-container"
     @onmouseenter="@(() => _visible = true)">
    @ChildContent
</div>

<SOverlay @bind-Visible="_visible"
          OverlayParent="this" Mode="SOverlayMode.Static"
          ControlType="SOverlayControlType.Hover"
          VerticalAlignment="SOverlayVerticalAlignment.OuterBottom"
          VerticalInterval="4">
    <div class="@GetClass()" style="@GetStyle()">
        @TooltipContent
    </div>
</SOverlay>