@namespace Secyud.Secits.Blazor
@inherits CComponentBase


<div class="@GetClass()" style="@GetStyle()">

    @if (MaxPageCount <= ShowPageCount)
    {
        for (var i = 0; i < MaxPageCount; i++)
        {
            @GeneratePageButton(i)
        }
    }
    else
    {
        var minPageIndex = Math.Max(0, _pageIndex - ShowPageCount / 2);
        var maxPageIndex = Math.Min(MaxPageCount, minPageIndex + ShowPageCount);

        <div key="first" class="s-pager-button" disabled="@(_pageIndex <= 0)"
             @onclick="TurnToFirstPageAsync">
            <i class="si-first-page"></i>
        </div>

        <div key="previous" class="s-pager-button" disabled="@(_pageIndex <= 0)"
             @onclick="TurnToPreviewPageAsync">
            <i class="si-preview-page"></i>
        </div>

        for (var i = minPageIndex; i < maxPageIndex; i++)
        {
            @GeneratePageButton(i)
        }

        <div key="next" class="s-pager-button" disabled="@(_pageIndex >= MaxPageCount - 1)"
             @onclick="TurnToNextPageAsync">
            <i class="si-first-page"></i>
        </div>

        <div key="last" class="s-pager-button" disabled="@(_pageIndex >= MaxPageCount - 1)"
             @onclick="TurnToLastPageAsync">
            <i class="si-first-page"></i>
        </div>
    }

</div>

@code{

    protected virtual RenderFragment GeneratePageButton(int i)
    {
        var disabled = i == _pageIndex ? "disabled" : null;

        return @<div @key="i" class="s-pager-button" disabled="@disabled"
                     @onclick="ChangePageIndexToSelectAsync">
                   @(i + 1)
               </div>;

        async Task ChangePageIndexToSelectAsync()
        {
            await ChangePageIndexAsync(i);
        }
    }

}
