@namespace Secyud.Secits.Blazor.Plugins
@typeparam TItem
@typeparam TField
@inherits SpTableColumnBase<TItem>

@Caption

@code {

    public RenderFragment GenerateColumn(TItem item)
    {
        var value = GetField(item);
        var text = string.Format(string.IsNullOrEmpty(Format) ? "{0}" : $"{{0:{Format}}}", value);

        return @<td>
                   @text
               </td>;
    }

}
