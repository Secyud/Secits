@namespace Secyud.Secits.Blazor
@inherits CComponentBase

<div @ref="ElementRef" class="@GetClass()" style="@GetStyle()">
    @if (Src is not null)
    {
        <img class="avatar-item-image" src="@Src" alt="@Alt"/>
    }
    else if (Text is not null)
    {
        <span class="avatar-item-text" alt="@Alt">@GetText()</span>
    }
    else
    {
        <i class="avatar-item-icon sis si-account" alt="@Alt"></i>
    }
</div>