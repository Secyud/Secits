@namespace Secyud.Secits.Blazor
@inherits CComponentBase

<table @ref="ElementRef" class="@GetClass()" style="@GetStyle()">
    <tbody>
    @for (var i = 0; i < 4; i++)
    {
        <tr>
            @for (var j = 0; j < 3; j++)
            {
                var month = i * 3 + j + 1;
                <td>
                    @month
                </td>
            }
        </tr>
    }
    </tbody>
</table>