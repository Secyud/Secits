@namespace Secyud.Secits.Blazor
@typeparam TValue
@inherits EComponentBase<TValue>

@(base.BuildRenderTree)

@code {

    protected override RenderFragment GenerateElements() => __builder =>
    {
        @base.GenerateElements()
        <span class="s-outer-spin-button">
            <i class="sii s-inner-spin-button s-spin-up"
               @onclick="StepUp"></i>
            <i class="sii s-inner-spin-button s-spin-down"
               @onclick="StepDown"></i>
        </span>
    };

}