@namespace Secyud.Secits.Blazor
@typeparam TValue
@inherits EComponentBase<TValue>

@(base.BuildRenderTree)

<SOverlay @bind-Visible="OverlayVisible"
          OverlayParent="this"
          HorizontalAlignment="SOverlayHorizontalAlignment.InnerLeft"
          VerticalAlignment="SOverlayVerticalAlignment.OuterBottom"
          VerticalInterval="4"
          ControlType="ControlType"
          Mode="SOverlayMode.Dynamic">
    <SDateTimePicker DateType="DateType" Color="Color" Size="Size"
                     @bind-Date="CurrentDate"
                     @bind-Time="CurrentTime"
                     FinishEdit="@(() => OverlayVisible = false)"/>
</SOverlay>

@code {

    protected override RenderFragment GenerateElements() => __builder =>
    {
        @base.GenerateElements()
        <i class="sii s-outer-spin-button s-calendar"
           @onclick="@OnCalendarClickAsync"></i>
    };

}