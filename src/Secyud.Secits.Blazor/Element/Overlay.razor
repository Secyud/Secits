@namespace Secyud.Secits.Blazor.Element
@inherits CComponentBase

@if (_hasAddOverlayToBody || _isWaitForOverlayFirstRender || HiddenMode)
{
    <div @ref="ElementRef"
         class="@GetClass()" style="@GetStyle()"
         @onmouseenter="OnOverlayMouseEnter"
         @onmouseleave="OnOverlayMouseLeave"
         @onmouseup="OnOverlayMouseUp"
         @onclick:stopPropagation>

        <CascadingValue Value="this" Name="Overlay" IsFixed>
            <CascadingValue Value="Trigger" Name="ParentTrigger" IsFixed>
                @if (!string.IsNullOrEmpty(OverlayChildPrefixCls))
                {
                    <CascadingValue Value="OverlayChildPrefixCls" Name="PrefixCls">
                        @if (ChildContent != null)
                        {
                            @ChildContent
                        }
                        else
                        {
                            @Trigger.Overlay
                        }
                    </CascadingValue>
                }
                else
                {
                    @if (ChildContent != null)
                    {
                        @ChildContent
                    }
                    else
                    {
                        @Trigger.Overlay
                    }
                }
            </CascadingValue>
        </CascadingValue>
    </div>
}